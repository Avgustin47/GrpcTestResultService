{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Masstransit": "Information",
        "Grpc": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "GrpcTestResultService",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Url": "http://*:80",
      "Protocols": "Http2"
    }
  },
  "Jwt": {
    "Key": "Секретный ключ fdisfjosfjosjfiodsfiodsjifdsiofjidsfjiosjdfisfjidjsfjdfjs",
    "Issuer": "AuthService",
    "Audience": "AllServices",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "MessageBroker": {
    "Host": "amqp://rabbitmq:5672",
    "Username": "admin",
    "Password": "admin123"
  }
}
