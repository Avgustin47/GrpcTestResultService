{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Masstransit": "Information",
        "Grpc": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "GrpcTestResultService",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Url": "http://*:80",
      "Protocols": "Http2"
    }
  },
  "Jwt": {
    "Key": "Секретный ключ fdisfjosfjosjfiodsfiodsjifdsiofjidsfjiosjdfisfjidjsfjdfjs",
    "Issuer": "AuthService",
    "Audience": "AllServices",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "MessageBroker": {
    "Host": "amqp://rabbitmq:5672",
    "Username": "admin",
    "Password": "admin123"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "redis:6379,password=qwerty,defaultDatabase=0,abortConnect=false,connectTimeout=5000,responseTimeout=5000",
    "InstanceName": "TestResultService",
    "DefaultCacheTime": 300,
    "CacheSlidingExpiration": 300,
    "CacheAbsoluteExpiration": 3600
  },
  "CacheSettings": {
    "TestType": {
      "CacheTime": 600,
      "AbsoluteExpiration": 3600
    }
  }
}
